// Enums based on PRD
enum Role {
  ADMIN // 개발 관리자
  SENIOR_PASTOR // 담임목사님
  PASTOR // 목사님
  LEADER // 셀리더/소그룹 리더
  MEMBER // 성도
  NEWCOMER // 새신자
}

enum PersonType {
  // 새신자 타입
  A // 교회가 처음인 사람
  B // 교회를 오랜만에 다시 나온 사람
  C // 교회가 익숙한 사람

  // 기존 성도 타입
  D // 예배만 드리는 성도
  E // 스스로 모임에 참여
  F // 전반적으로 적극적
  G // 관심이 필요한 성도
}

enum VisaType {
  STUDENT
  WORKING_HOLIDAY
  TRAVELLING
  SPONSERSHIP
  CITIZENSHIP
  PR
  GRADUATE
  ETC
}

enum ProcessStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

model GroupType {
  id String @id @default(uuid())

  // Basic Info
  name  String
  order Int

  // Relations
  groups Group[]

  church         Church       @relation(fields: [churchId], references: [id])
  churchId       String
  seniorPastor   SeniorPastor @relation(fields: [seniorPastorId], references: [id])
  seniorPastorId String

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id String @id @default(uuid())

  // Basic Info
  name        String
  type        GroupType @relation(fields: [groupTypeId], references: [id])
  groupTypeId String

  // Relations
  church    Church?
  subGroups SubGroup[]

  // Metadata
  createdAt DateTime @default(now())
}

model Church {
  id    String @id
  group Group  @relation(fields: [id], references: [id])

  // Basic Info
  address        String?
  phone          String?
  estDate        DateTime?
  seniorPastor   SeniorPastor @relation(fields: [seniorPastorId], references: [id])
  seniorPastorId String
  groupTypes     GroupType[]

  // Metadata
  updatedAt DateTime @updatedAt
}

model SubGroup {
  id    String @id
  group Group  @relation(fields: [id], references: [id])

  // Hierarchy
  parent   SubGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  parentId String?
  children SubGroup[] @relation("GroupHierarchy")

  // Leader
  pastor   Pastor? @relation("GroupPastor", fields: [pastorId], references: [id])
  pastorId String?
  leader   Leader? @relation("GroupLeader", fields: [leaderId], references: [id])
  leaderId String? @unique

  members Person[]

  // Metadata
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  // Auth info
  email String @unique
  hash  String

  // Relations
  person Person?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id String @id @default(uuid())

  // Personal info
  firstName     String
  lastName      String
  gender        Boolean   @default(true)
  phone         String
  kakaoAccount  String?
  bod           DateTime?
  address       String?
  profileImgUrl String?
  occupation    String?
  visaType      VisaType?

  // Church specific info
  assignedAt  DateTime @default(now())
  role        Role     @default(MEMBER)
  hasBaptized Boolean  @default(false)

  // Note
  note String?

  // Relations
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  group   SubGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  invitedNewcomers Newcomer[] @relation("NewcomerInviter")

  // Role specific info
  seniorPastor SeniorPastor?
  pastor       Pastor?
  leader       Leader?
  member       Member?
  newcomer     Newcomer?

  // Metadata
  createdAt DateTime @default(now())
}

model SeniorPastor {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Relations
  churches   Church[]
  groupTypes GroupType[]

  // Metadata
  updatedAt DateTime @updatedAt
}

model Pastor {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Relations
  ledGroups SubGroup[] @relation("GroupPastor")

  // Metadata
  updatedAt DateTime @updatedAt
}

model Leader {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Relations
  leadGroup SubGroup? @relation("GroupLeader")

  // Metadata
  updatedAt DateTime @updatedAt
}

model Member {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Basic Info
  type PersonType @default(D)

  // Metadata
  updatedAt DateTime @updatedAt
}

model Newcomer {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Basic Info
  type           PersonType @default(A)
  inviter        Person?    @relation(name: "NewcomerInviter", fields: [inviterId], references: [id])
  inviterId      String?
  prevChurch     String?
  prevServedPart String?

  // Process
  processStatus ProcessStatus @default(READY)

  // Metadata
  updatedAt DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/shared/prisma"
}

datasource db {
  provider = "postgresql"
}
