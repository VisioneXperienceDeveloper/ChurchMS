model User {
  id String @id @default(uuid())

  // Auth info
  email String @unique
  hash  String

  // Relations
  person Person?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id String @id @default(uuid())

  // Personal info
  firstName     String
  lastName      String
  gender        Boolean   @default(true)
  phone         String
  kakaoAccount  String?
  bod           DateTime?
  address       String?
  profileImgUrl String?
  occupation    String?
  visaType      VisaType?

  // Church specific info
  assignedAt  DateTime @default(now())
  role        Role     @default(MEMBER)
  hasBaptized Boolean  @default(false)

  // Note
  note String?

  // Relations
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  group   SubGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  invitedNewcomers Newcomer[] @relation("NewcomerInviter")

  // Role specific info
  seniorPastor SeniorPastor?
  pastor       Pastor?
  leader       Leader?
  member       Member?
  newcomer     Newcomer?

  // Metadata
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model SeniorPastor {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Relations
  churches   Church[]
  groupTypes GroupType[]

  // Metadata
  updatedAt DateTime @updatedAt
}

model Pastor {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Relations
  ledGroups SubGroup[] @relation("GroupPastor")

  // Metadata
  updatedAt DateTime @updatedAt
}

model Leader {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Relations
  leadGroup SubGroup? @relation("GroupLeader")

  // Metadata
  updatedAt DateTime @updatedAt
}

model Member {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Basic Info
  type PersonType @default(D)

  // Metadata
  updatedAt DateTime @updatedAt
}

model Newcomer {
  id     String @id
  person Person @relation(fields: [id], references: [id])

  // Basic Info
  type           PersonType @default(A)
  inviter        Person?    @relation(name: "NewcomerInviter", fields: [inviterId], references: [id])
  inviterId      String?
  prevChurch     String?
  prevServedPart String?

  // Process
  processStatus ProcessStatus @default(READY)

  // Metadata
  updatedAt DateTime @updatedAt
}
